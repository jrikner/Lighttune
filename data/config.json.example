{
  "_comment": "Copy this file to config.json at the plugin root (same folder as plugin.xml), NOT inside data/.",

  "_comment_github_username": "Your GitHub handle for fixture log attribution. Leave blank or use Settings in the plugin menu to set it.",
  "github_username":   "your_github_username",

  "bridge_ip":         "127.0.0.1",
  "_comment_bridge_ip_mac": "PRIMARY (macOS onPC): use 127.0.0.1 when sekonic-bridge runs on the same Mac as onPC with C-7000 USB",
  "_comment_bridge_ip_pi": "SECONDARY (stage split): e.g. 192.168.1.50 when console and meter are on different machines",
  "bridge_port":       8765,

  "_comment_bridge_api_key": "Optional shared secret when the bridge has BRIDGE_API_KEY or bridge_api_key configured",
  "bridge_api_key":    "",

  "_comment_focus_preset": "Position preset (pool 2) with fixtures aimed at Sekonic — e.g. 2.12 or 12",
  "focus_preset":      "",

  "_comment_open_bridge_browser": "When true, open the bridge dashboard in the system browser on plugin start (onPC only). Default: false — use Open Bridge from the menu instead.",
  "open_bridge_browser": false,

  "_comment_bridge_auto_continue_sec": "Hands-free bridge mode: seconds before auto-continuing past info dialogs (default 3, set 0 to skip pause)",
  "bridge_auto_continue_sec": 3
}
